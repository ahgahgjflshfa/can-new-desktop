{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "立馬幫幫忙",
  "version": "1.1.12",
  "identifier": "com.tymetro.my",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "立馬幫幫忙",
        "width": 800,
        "height": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost tauri://localhost https://tauri.localhost http: https: ws: wss:",
        "media-src": "'self' asset: blob: data: http: https:",
        "worker-src": "'self' blob:",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    }
  }
}
